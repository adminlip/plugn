# Database
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=plugn
MYSQL_USER=plugn
MYSQL_PASSWORD=CHANGE_ME_user_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# App
APP_ENV=Production-Docker

# AWS (S3 / SQS) - use instance IAM roles in production, keys only for local dev
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-2
# AWS_S3_BUCKET=plugn-uploads

# SQS Queue
# SQS_REGION=eu-west-2
# SQS_KEY=
# SQS_SECRET=
# SQS_QUEUE=

# Mail (SMTP)
# MAILER_HOST=
# MAILER_PORT=587
# MAILER_USERNAME=
# MAILER_PASSWORD=
# MAILER_ENCRYPTION=tls

# GPT / AI Service
# GPT_TOKEN=
# GPT_ENDPOINT=

# Tap Payments
# TAP_SECRET_KEY=
# TAP_PUBLIC_KEY=

# Auth0
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
